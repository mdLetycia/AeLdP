programa {
  funcao inicio() {
    //Declaração de Variavel
    real raio, altura, volume

    //Entrada de dados
    escreva("informe o raio da base: ")
    leia(raio)
    escreva("informe a altura da embalagem: ")
    leia(altura)
   
    //Processamento
    volume= 3.14159*raio*altura

    //saida de dados
    escreva("O volume da embalagem é: ", volume)
  }
}
