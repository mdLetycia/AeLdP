programa {
  funcao inicio() {
    //Declaração de Variavel
    cadeia: nome, sobrenome;

    //entrada de dados
    escreva:("Informe seu nome: ");
    leia:(nome);
    escreva:("informe seu sobrenome: ");
    leia:(sobrenome);

    //Saida de dados
    escreva:("Seu nome em português é: ",nome," ", sobrenome,"\n");
    escreva:("Seu nome em Japonês é: ", sobrenome," ", nome, "\n");
  }
}
